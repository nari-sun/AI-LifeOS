{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Phase2.6: Start Codex Conversation",
      "type": "process",
      "command": "python",
      "args": [
        "scripts\\codex_conversation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8",
          "AI_LIFEOS_DEBUG_LOG": "${workspaceFolder}\\logs\\codex_conversation_debug.log"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
