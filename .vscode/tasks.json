{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Phase2.6: Start Codex Conversation",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts\\codex_conversation.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8"
        },
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoLogo",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
