{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-LifeOS",
  "version": "0.1.0",
  "identifier": "local.ai-lifeos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI-LifeOS",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/AI-LifeOS/tts/**/*"]
      }
    }
  }
}
